# SENTINEL Platform Configuration
# Copy to .env and fill in your values

# AI Provider (auto, watsonx, ollama, huggingface, mock)
GRANITE_MODE=mock

# IBM watsonx.ai
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite-code:8b

# HuggingFace
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=ibm-granite/granite-3.0-8b-instruct

# Mock Mode
MOCK_LATENCY_MIN=200
MOCK_LATENCY_MAX=800

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8500

# External Data
NASA_API_KEY=DEMO_KEY
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/telemetry_engine/stream
